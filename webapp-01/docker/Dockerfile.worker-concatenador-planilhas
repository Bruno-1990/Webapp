# Build a partir da raiz do monorepo (contexto = ./webapp).
# docker compose --profile comparacao build worker-concatenador-planilhas
FROM node:22-bookworm-slim AS build-js
WORKDIR /workspace/webapp-01
COPY webapp-01/package.json webapp-01/package-lock.json* ./
COPY webapp-01/tsconfig.base.json ./
COPY webapp-01/packages ./packages
COPY webapp-01/apps ./apps
COPY webapp-01/frontend ./frontend
RUN npm ci --workspaces --include-workspace-root 2>/dev/null || npm install --workspaces --include-workspace-root
# `tsc -b` segue as `references` do tsconfig e compila as dependencias
# na ordem certa — sem lista de pacotes para manter aqui.
RUN npx tsc -b apps/worker-concatenador-planilhas

# Instala deps do engine standalone (engines/concatenador-planilhas).
FROM node:22-bookworm-slim AS build-engine
WORKDIR /engine
COPY engines/concatenador-planilhas/package.json ./
RUN npm install --omit=dev

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build-js /workspace/webapp-01/package.json ./
COPY --from=build-js /workspace/webapp-01/node_modules ./node_modules
COPY --from=build-js /workspace/webapp-01/packages ./packages
COPY --from=build-js /workspace/webapp-01/apps/worker-concatenador-planilhas ./apps/worker-concatenador-planilhas
COPY engines/concatenador-planilhas /app/engines/concatenador-planilhas
COPY --from=build-engine /engine/node_modules /app/engines/concatenador-planilhas/node_modules
ENV CONCATENADOR_DIR=/app/engines/concatenador-planilhas
CMD ["node", "apps/worker-concatenador-planilhas/dist/index.js"]
